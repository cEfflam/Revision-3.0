# ── Secrets ───────────────────────────────────────────────────────────────
.env
.env.local
.env.*.local
!.env.example

# Fichiers où traînent des clés d'API. Tout ce qui ressemble à une clé
# posée à la racine est exclu par défaut : mieux vaut ignorer un fichier
# inoffensif que publier un secret.
OpenRouter.txt
openrouter*.txt
*api*key*.txt
*.key
secrets/

# ── Python / Backend ──────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
backend/storage/*
!backend/storage/.gitkeep

# ── Node / Frontend ───────────────────────────────────────────────────────
node_modules/
.next/
out/
build/
dist/
*.tsbuildinfo
next-env.d.ts
.eslintcache

# ── Outils / OS ───────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# ── Données locales ───────────────────────────────────────────────────────
*.sqlite3
*.db
.fastembed_cache/
