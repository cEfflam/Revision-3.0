# ==========================================================================
#  REVISIO 3.0 — Variables d'environnement
#  Copie ce fichier en `.env` :  cp .env.example .env
#  Le `.env` n'est JAMAIS commité (voir .gitignore).
# ==========================================================================

# ── PostgreSQL (données structurées) ──────────────────────────────────────
POSTGRES_USER=revisio
POSTGRES_PASSWORD=revisio_dev_password
POSTGRES_DB=revisio
# Port exposé sur ta machine. 5433 et non 5432 pour ne pas entrer en
# conflit avec un PostgreSQL déjà installé en local.
POSTGRES_PORT=5433

# ── Qdrant (base vectorielle / mémoire IA) ────────────────────────────────
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334

# ── Backend FastAPI ───────────────────────────────────────────────────────
BACKEND_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO
# Génère une vraie clé pour la prod :
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-secret-change-me-in-production-please-seriously
ACCESS_TOKEN_EXPIRE_MINUTES=10080
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3005

# Crée un compte de démo au démarrage (dev uniquement).
SEED_DEMO_USER=true
# Attention : pas de domaine réservé (.local, .test) — EmailStr le refuserait.
DEMO_USER_EMAIL=demo@revisio.app
DEMO_USER_PASSWORD=revisio123

# ── IA : OpenRouter ───────────────────────────────────────────────────────
# AI_MOCK=true → aucune requête réseau, réponses simulées déterministes.
# Mets false + une clé API quand tu veux brancher les vrais modèles.
AI_MOCK=true
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_NAME=REVISIO
OPENROUTER_SITE_URL=http://localhost:3000

# Les 3 paliers de l'AI Router. Vérifie les slugs sur openrouter.ai/models,
# ils évoluent régulièrement.
#
# Par défaut le même modèle partout : la différence de coût se joue sur le
# raisonnement (activé uniquement pour le palier « reasoning »), pas sur le
# modèle. Contrepartie : la chaîne de repli n'a plus qu'un maillon. Mets un
# second modèle dans AI_MODEL_CHEAP pour retrouver de la résilience.
AI_MODEL_CHEAP=deepseek/deepseek-v4-flash-0731
AI_MODEL_STANDARD=deepseek/deepseek-v4-flash-0731
AI_MODEL_REASONING=deepseek/deepseek-v4-flash-0731
AI_REQUEST_TIMEOUT=120

# Interrupteur général du raisonnement. Les jetons de réflexion sont facturés
# comme les autres : à false, tu coupes ce poste de dépense entièrement.
AI_REASONING=true

# ── Embeddings (vectorisation des documents) ──────────────────────────────
# fastembed = local, gratuit, aucune clé. openai = payant. hash = fallback
# déterministe sans dépendance (utile pour les tests).
EMBEDDING_PROVIDER=fastembed
# Doit être un modèle supporté par fastembed (et multilingue : cours en français).
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIM=384
OPENAI_API_KEY=

# ── RAG ───────────────────────────────────────────────────────────────────
CHUNK_MAX_CHARS=1200
CHUNK_OVERLAP_CHARS=150
RAG_TOP_K=6
MAX_UPLOAD_MB=25

# ── Frontend (lu par Next.js) ─────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_NAME=REVISIO
